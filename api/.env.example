# Copy to .env and fill in. Never commit .env.

# Matches docker-compose.yml. In production use the URL from your Postgres host.
DATABASE_URL=postgresql://media:media@localhost:5432/media_upload

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:4000

# Object storage (Cloudflare R2 or AWS S3). Needed from day 4.
# For R2 the endpoint is https://<account-id>.r2.cloudflarestorage.com and the region is "auto".
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
